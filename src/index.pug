extends _layouts/layout.pug

block vars
  - var pageTitle = "Soul Hatch - Home"
  - 
    var events = [
      {
        title: "Punch Buggy Brewing",
        date: "Oct 17",
        time: "8pm",
        description: "",
        image: ""
      },
      {
        title: "Cosmic Cafe",
        date: "Oct 24",
        time: "12-3pm",
        description: "",
        image: ""
      },
      {
        title: "DNS Fest",
        date: "Oct 31",
        time: "12-8pm",
        description: "Soul Hatch is playing at DNS Fest, time slot TBA",
        image: ""
      },
    ]

block hero
  .hero-banner
    .container
      h1 Soul Hatch
      h2 One stop shop for all your cosmic-chaotic needs

block content
  .grid
    div
      article
        h2 Upcoming Events
        #events(style="margin-left: 20px")
          each event in events
            details(open)
              summary [#{event.date}] #{event.title} #{event.time}
              if event.description && event.description.length > 0
                p= event.description
              else
                p(style="font-style: italic") No additional information is available for this event yet.
              if event.image
                img(src=event.image style="width: 75%")

    div
      article
        h1 Sign up for our mailing list
        form.listmonk-form(method="post" action="https://listmonk.soulhatch.band/subscription/form")
          div
            h3 Subscribe
            input(type="hidden" name="nonce")
            p
              input(type="email" name="email" required placeholder="E-mail")
            p
              input(type="text" name="name" placeholder="Name (optional)")
            p
              input#531d2(type="checkbox" name="l" checked value="531d2448-8927-4046-ba12-bfa9cc874ba2")
              label(for="531d2") Soul Hatch Events
              br
              span Sign up for Soul Hatch Mailing List
            input(type="submit" value="Subscribe ")
